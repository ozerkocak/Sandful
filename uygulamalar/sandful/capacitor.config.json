{
  "appId": "com.investateknoloji.sandful",
  "appName": "Sandful",
  "webDir": "www",
  "backgroundColor": "#d9c4a5",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#d9c4a5"
  },
  "android": {
    "backgroundColor": "#d9c4a5"
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/analytics": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/analytics": [
            "AnalyticsWithoutAdIdSupport"
          ]
        }
      }
    }
  }
}
